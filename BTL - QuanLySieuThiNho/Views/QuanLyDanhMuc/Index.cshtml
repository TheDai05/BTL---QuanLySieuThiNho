@{ ViewData["Title"] = "Quản lý danh mục"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="card border-0 shadow-sm">
    <div class="card-header bg-success text-white">
        <h6 class="mb-0"><i class="bi bi-grid"></i> Danh sách loại sản phẩm</h6>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr><th>STT</th><th>Tên loại sản phẩm</th><th>Số lượng sản phẩm</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var dm in ViewBag.Categories)
                {
                    <tr>
                        <td>@(stt++)</td>
                        <td class="fw-semibold">@dm.TenDanhMuc</td>
                        <td><span class="badge bg-info">@dm.SoSanPham sản phẩm</span></td>
                        <td>
                            <a href="/Admin/QuanLySanPham?loaiSp=@dm.TenDanhMuc" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> Xem sản phẩm
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
