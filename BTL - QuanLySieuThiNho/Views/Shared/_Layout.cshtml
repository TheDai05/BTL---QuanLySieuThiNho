<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Siêu Thị Nhỏ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root { --primary: #28a745; --dark-green: #1e7e34; }
        .navbar-brand { font-weight: 700; font-size: 1.4rem; }
        .navbar { box-shadow: 0 2px 8px rgba(0,0,0,.1); }
        .cart-badge { position: absolute; top: -5px; right: -8px; font-size: .65rem; }
        .footer { background: #2c3e50; color: #ecf0f1; padding: 40px 0 20px; }
        .footer a { color: #bdc3c7; text-decoration: none; }
        .footer a:hover { color: white; }
        .breadcrumb-wrapper { background: #f8f9fa; border-bottom: 1px solid #dee2e6; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-success sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-shop"></i> Siêu Thị Nhỏ
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <!-- Search bar -->
                <form class="d-flex mx-auto" asp-controller="Home" asp-action="Index" method="get" style="width:40%">
                    <input class="form-control me-2" type="search" name="timKiem"
                           placeholder="Tìm kiếm sản phẩm..."
                           value="@ViewData["TimKiem"]"
                           autocomplete="off" id="searchInput" />
                    <button class="btn btn-light" type="submit"><i class="bi bi-search"></i></button>
                </form>
                <!-- Search suggestions -->
                <div id="searchSuggestions" class="list-group position-absolute shadow" style="display:none; top:58px; z-index:9999; min-width:300px;"></div>

                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house"></i> Trang chủ
                        </a>
                    </li>
                    <!-- Giỏ hàng -->
                    <li class="nav-item me-2">
                        <a class="nav-link position-relative" asp-controller="GioHang" asp-action="Index">
                            <i class="bi bi-cart3 fs-5"></i>
                            <span class="badge bg-danger rounded-pill cart-badge" id="cartCount">0</span>
                        </a>
                    </li>
                    <!-- User menu -->
                    @if (Context.Session.GetString("KhachHangMa") != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i> @Context.Session.GetString("KhachHangHoTen")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ThongTin">
                                    <i class="bi bi-person"></i> Thông tin cá nhân
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="DonHang" asp-action="LichSuMuaHang">
                                    <i class="bi bi-clock-history"></i> Lịch sử mua hàng
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="DangXuat">
                                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                                </a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="DangNhap">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm ms-1" asp-controller="Account" asp-action="DangKy">
                                Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-0 rounded-0" role="alert">
            <div class="container">
                <i class="bi bi-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-0 rounded-0" role="alert">
            <div class="container">
                <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <!-- Main content -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="footer mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5><i class="bi bi-shop"></i> Siêu Thị Nhỏ</h5>
                    <p class="text-muted">Mua sắm tiện lợi, giá cả phải chăng.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Liên kết</h6>
                    <ul class="list-unstyled">
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li><a asp-controller="Account" asp-action="DangKy">Đăng ký</a></li>
                        <li><a asp-controller="DonHang" asp-action="LichSuMuaHang">Đơn hàng của tôi</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Liên hệ</h6>
                    <p><i class="bi bi-telephone"></i> 1800-1234</p>
                    <p><i class="bi bi-envelope"></i> support&#64;sieuthinho.vn</p>
                    <p><i class="bi bi-geo-alt"></i> Hà Nội, Việt Nam</p>
                </div>
            </div>
            <hr class="border-secondary">
            <p class="text-center text-muted small mb-0">© 2024 Siêu Thị Nhỏ. Bài tập lớn Lập trình Web.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Cập nhật số lượng giỏ hàng
        function capNhatSoLuongGio() {
            $.get('/GioHang/SoLuongGio', function(data) {
                $('#cartCount').text(data.count > 0 ? data.count : '0');
            });
        }
        capNhatSoLuongGio();

        // Gợi ý tìm kiếm (AJAX)
        $('#searchInput').on('input', function() {
            var q = $(this).val();
            if (q.length < 2) { $('#searchSuggestions').hide(); return; }
            $.get('/Home/TimKiemGoiY?q=' + encodeURIComponent(q), function(data) {
                if (!data || data.length === 0) { $('#searchSuggestions').hide(); return; }
                var html = '';
                data.forEach(function(sp) {
                    html += '<a href="/Home/ChiTiet/' + sp.maSp + '" class="list-group-item list-group-item-action">';
                    html += '<small class="fw-semibold">' + sp.tenSanPham + '</small>';
                    html += '<span class="float-end text-success small">' + formatCurrency(sp.gia) + '</span></a>';
                });
                $('#searchSuggestions').html(html).show();
            });
        });

        $(document).click(function(e) {
            if (!$(e.target).closest('#searchInput, #searchSuggestions').length)
                $('#searchSuggestions').hide();
        });

        function formatCurrency(n) {
            return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(n);
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
