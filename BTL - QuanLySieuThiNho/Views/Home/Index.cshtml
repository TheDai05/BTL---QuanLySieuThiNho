@model BTL___QuanLySieuThiNho.ViewModels.SanPhamListVM
@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Hero Banner -->
<div class="bg-success text-white py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="fw-bold"><i class="bi bi-shop"></i> Siêu Thị Nhỏ</h1>
                <p class="lead mb-0">Mua sắm tiện lợi, tươi ngon mỗi ngày - Giao hàng tận nơi!</p>
            </div>
            <div class="col-md-4 text-end">
                <i class="bi bi-basket3-fill" style="font-size: 5rem; opacity:.3;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="row">
        <!-- Sidebar: Loại sản phẩm -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-grid-3x3-gap"></i> Loại sản phẩm
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-timKiem="@Model.TimKiem" asp-route-sapXep="@Model.SapXep"
                       class="list-group-item list-group-item-action @(Model.LoaiSp == null ? "active" : "")">
                        <i class="bi bi-collection"></i> Tất cả sản phẩm
                    </a>
                    @foreach (var loai in Model.LoaiSanPhams)
                    {
                        <a asp-action="Index" asp-route-loaiSp="@loai" asp-route-timKiem="@Model.TimKiem"
                           asp-route-sapXep="@Model.SapXep"
                           class="list-group-item list-group-item-action @(Model.LoaiSp == loai ? "active" : "")">
                            @loai
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    @if (!string.IsNullOrEmpty(Model.TimKiem))
                    {
                        <span>Kết quả: <strong>"@Model.TimKiem"</strong>
                            <a asp-action="Index" asp-route-loaiSp="@Model.LoaiSp" class="text-muted ms-1 small">✕ Xóa</a>
                        </span>
                    }
                    <small class="text-muted">(@Model.SanPhams.Count() sản phẩm)</small>
                </div>
                <form asp-action="Index" method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="timKiem" value="@Model.TimKiem" />
                    <input type="hidden" name="loaiSp" value="@Model.LoaiSp" />
                    <select name="sapXep" class="form-select form-select-sm" onchange="this.form.submit()" style="width:auto">
                        <!option value="default" @(Model.SapXep == "default" ? "selected" : "")>Mặc định</!option>
                        <!option value="giatang" @(Model.SapXep == "giatang" ? "selected" : "")>Giá tăng dần</!option>
                        <!option value="giagiam" @(Model.SapXep == "giagiam" ? "selected" : "")>Giá giảm dần</!option>
                        <!option value="moi" @(Model.SapXep == "moi" ? "selected" : "")>Mới nhất</!option>
                    </select>
                </form>
            </div>

            @if (!Model.SanPhams.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-search" style="font-size: 3rem; color: #ccc;"></i>
                    <p class="text-muted mt-3">Không tìm thấy sản phẩm nào</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-sm-2 row-cols-xl-4 g-3">
                    @foreach (var sp in Model.SanPhams)
                    {
                        <div class="col">
                            <div class="card h-100 border-0 shadow-sm product-card">
                                <a asp-action="ChiTiet" asp-route-id="@sp.MaSp" class="d-block overflow-hidden bg-light rounded-top" style="height:180px;">
                                    <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "/images/no-image.svg" : (sp.HinhAnh.StartsWith("http") || sp.HinhAnh.StartsWith("/") ? sp.HinhAnh : "/" + sp.HinhAnh))"
                                         class="card-img-top w-100 h-100" alt="@sp.TenSp"
                                         style="object-fit:cover;"
                                         onerror="this.onerror=null; this.src='/images/no-image.svg';" />
                                </a>
                                <div class="card-body d-flex flex-column p-3">
                                    <small class="text-muted">@sp.LoaiSp</small>
                                    <h6 class="card-title mb-1">
                                        <a asp-action="ChiTiet" asp-route-id="@sp.MaSp" class="text-dark text-decoration-none">@sp.TenSp</a>
                                    </h6>
                                    <p class="text-success fw-bold mb-1 mt-auto">@sp.GiaBan.ToString("N0") ₫</p>
                                    @if ((sp.SoLuongTon ?? 0) > 0)
                                    {
                                        <small class="text-muted mb-2">Còn @sp.SoLuongTon sản phẩm</small>
                                        <button class="btn btn-success btn-sm w-100 btn-them-gio" data-id="@sp.MaSp">
                                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                        </button>
                                    }
                                    else
                                    {
                                        <small class="text-danger mb-2">Hết hàng</small>
                                        <button class="btn btn-secondary btn-sm w-100" disabled>Hết hàng</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                @if (Model.TongSoTrang > 1)
                {
                    <nav class="mt-4">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.TrangHienTai == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-trang="@(Model.TrangHienTai - 1)"
                                   asp-route-timKiem="@Model.TimKiem" asp-route-loaiSp="@Model.LoaiSp" asp-route-sapXep="@Model.SapXep">‹</a>
                            </li>
                            @for (int i = 1; i <= Model.TongSoTrang; i++)
                            {
                                <li class="page-item @(i == Model.TrangHienTai ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-trang="@i"
                                       asp-route-timKiem="@Model.TimKiem" asp-route-loaiSp="@Model.LoaiSp" asp-route-sapXep="@Model.SapXep">@i</a>
                                </li>
                            }
                            <li class="page-item @(Model.TrangHienTai == Model.TongSoTrang ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-trang="@(Model.TrangHienTai + 1)"
                                   asp-route-timKiem="@Model.TimKiem" asp-route-loaiSp="@Model.LoaiSp" asp-route-sapXep="@Model.SapXep">›</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).on('click', '.btn-them-gio', function () {
        var btn = $(this);
        var sanPhamId = btn.data('id');
        btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span>');
        $.post('/GioHang/ThemVaoGio', { sanPhamId: sanPhamId, soLuong: 1 }, function (res) {
            if (res.success) {
                $('#cartCount').text(res.soLuongGio);
                btn.html('<i class="bi bi-check"></i> Đã thêm').addClass('btn-outline-success').removeClass('btn-success');
                setTimeout(function () {
                    btn.html('<i class="bi bi-cart-plus"></i> Thêm vào giỏ').removeClass('btn-outline-success').addClass('btn-success').prop('disabled', false);
                }, 2000);
            } else {
                alert(res.message);
                btn.html('<i class="bi bi-cart-plus"></i> Thêm vào giỏ').prop('disabled', false);
            }
        });
    });
</script>
}
