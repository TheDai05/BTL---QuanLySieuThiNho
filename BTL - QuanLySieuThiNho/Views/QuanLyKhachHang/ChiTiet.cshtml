@model BTL___QuanLySieuThiNho.Models.KhachHang
@{ ViewData["Title"] = $"Khách hàng: {Model.TenKh}"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex gap-2 mb-3">
    <a href="/Admin/QuanLyKhachHang" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>
<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header"><strong>Thông tin khách hàng</strong></div>
            <div class="card-body">
                <p><strong>Mã KH:</strong> @Model.MaKh</p>
                <p><strong>Họ tên:</strong> @Model.TenKh</p>
                <p><strong>Tên đăng nhập:</strong> @(Model.TenDangNhap ?? "Chưa tạo")</p>
                <p><strong>SĐT:</strong> @Model.SoDienThoai</p>
                <p><strong>Email:</strong> @(Model.Email ?? "Chưa cập nhật")</p>
                <p><strong>Địa chỉ:</strong> @(Model.DiaChi ?? "Chưa cập nhật")</p>
                <p><strong>Điểm tích lũy:</strong> <span class="badge bg-success">@(Model.DiemTichLuy ?? 0)</span></p>
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header"><strong>Lịch sử mua hàng (@(Model.HoaDons?.Count ?? 0) hóa đơn)</strong></div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="bg-light"><tr><th>Mã HĐ</th><th>Ngày lập</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var d in Model.HoaDons ?? new List<BTL___QuanLySieuThiNho.Models.HoaDon>())
                        {
                            <tr>
                                <td>#@d.MaHd</td>
                                <td>@d.NgayLap.ToString("dd/MM/yyyy")</td>
                                <td class="text-success fw-bold">@d.TongTien.ToString("N0") ₫</td>
                                <td>
                                    @{
                                        var badge = d.TrangThai switch {
                                            0 => "warning", 1 => "info", 2 => "primary", 3 => "success", 4 => "secondary", _ => "secondary"
                                        };
                                        var text = d.TrangThai switch {
                                            0 => "Chờ xác nhận", 1 => "Đã xác nhận", 2 => "Đang giao", 3 => "Đã giao", 4 => "Đã hủy", _ => "?"
                                        };
                                    }
                                    <span class="badge bg-@badge">@text</span>
                                </td>
                                <td>
                                    <a href="/Admin/QuanLyDonHang/ChiTiet/@d.MaHd" class="btn btn-outline-primary btn-sm py-0">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
