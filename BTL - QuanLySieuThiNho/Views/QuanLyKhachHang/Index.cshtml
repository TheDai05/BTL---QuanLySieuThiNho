@model List<BTL___QuanLySieuThiNho.Models.KhachHang>
@{ ViewData["Title"] = "Quản lý khách hàng"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="mb-3">
    <form method="get" class="d-flex gap-2">
        <input type="text" name="timKiem" value="@ViewBag.TimKiem" class="form-control" placeholder="Tìm theo tên, SĐT, Email..." style="max-width:300px" />
        <button type="submit" class="btn btn-outline-success"><i class="bi bi-search"></i></button>
    </form>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr><th>Mã KH</th><th>Họ tên</th><th>Tài khoản</th><th>SĐT</th><th>Địa chỉ</th><th>Điểm tích lũy</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach (var kh in Model)
                    {
                        <tr>
                            <td><code>@kh.MaKh</code></td>
                            <td class="fw-semibold">@kh.TenKh</td>
                            <td class="text-muted">@(kh.TenDangNhap ?? "Chưa tạo")</td>
                            <td>@kh.SoDienThoai</td>
                            <td class="small text-muted" style="max-width:200px;">@kh.DiaChi</td>
                            <td><span class="badge bg-success">@(kh.DiemTichLuy ?? 0)</span></td>
                            <td>
                                <a href="/Admin/QuanLyKhachHang/ChiTiet/@kh.MaKh" class="btn btn-outline-info btn-sm">
                                    <i class="bi bi-eye"></i> Xem lịch sử
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if ((int)ViewBag.TongSoTrang > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TongSoTrang; i++)
            {
                <li class="page-item @(i == (int)ViewBag.TrangHienTai ? "active" : "")">
                    <a class="page-link" href="/Admin/QuanLyKhachHang?trang=@i&timKiem=@ViewBag.TimKiem">@i</a>
                </li>
            }
        </ul>
    </nav>
}
