@model BTL___QuanLySieuThiNho.ViewModels.AdminDangNhapVM
@{ ViewData["Title"] = "Đăng nhập quản trị"; Layout = null; }
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - Siêu Thị Nhỏ</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>body { background: #2c3e50; }</style>
</head>
<body class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="card border-0 shadow-lg" style="width:420px">
        <div class="card-header bg-success text-white text-center py-4">
            <i class="bi bi-shield-lock" style="font-size:2.5rem;"></i>
            <h4 class="mt-2 mb-0">Quản trị viên</h4>
            <small>Hệ thống Quản Lý Siêu Thị Nhỏ</small>
        </div>
        <div class="card-body p-4">
            <form asp-controller="AdminAccount" asp-action="DangNhap" method="post">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 mb-3">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <div><i class="bi bi-exclamation-circle"></i> @error.ErrorMessage</div>
                        }
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label fw-semibold">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="TenDangNhap" class="form-control" placeholder="admin" required autofocus />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="MatKhau" class="form-label fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="MatKhau" type="password" class="form-control" placeholder="••••••" required />
                    </div>
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-success btn-lg">
                        <i class="bi bi-box-arrow-in-right"></i> Đăng nhập Admin
                    </button>
                </div>
            </form>
        </div>
        <div class="card-footer text-center py-3">
            <a href="/" class="text-muted small"><i class="bi bi-arrow-left"></i> Về trang chủ</a>
            <span class="mx-2 text-muted">|</span>
            <a href="/Account/DangNhap" class="text-muted small">Đăng nhập Khách hàng</a>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
