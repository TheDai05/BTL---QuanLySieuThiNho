@model BTL___QuanLySieuThiNho.ViewModels.DatHangVM
@{ ViewData["Title"] = "Đặt hàng"; }

<div class="container py-4">
    <h4 class="mb-4"><i class="bi bi-credit-card"></i> Xác nhận đặt hàng</h4>
    <div class="row g-4">
        <!-- Thông tin giao hàng -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="bi bi-geo-alt"></i> Thông tin giao hàng</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="DonHang" asp-action="XacNhanDatHang" method="post" id="formDatHang">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 mb-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div><i class="bi bi-exclamation-circle"></i> @error.ErrorMessage</div>
                                }
                            </div>
                        }
                        <div class="mb-3">
                            <label asp-for="HoTenNguoiNhan" class="form-label fw-semibold"></label>
                            <input asp-for="HoTenNguoiNhan" class="form-control" placeholder="Họ và tên người nhận" required />
                            <span asp-validation-for="HoTenNguoiNhan" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SdtNguoiNhan" class="form-label fw-semibold"></label>
                            <input asp-for="SdtNguoiNhan" class="form-control" placeholder="Số điện thoại nhận hàng (VD: 0968903705)" required />
                            <span asp-validation-for="SdtNguoiNhan" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DiaChiGiao" class="form-label fw-semibold"></label>
                            <textarea asp-for="DiaChiGiao" class="form-control" rows="2" placeholder="Địa chỉ nhận hàng chi tiết" required></textarea>
                            <span asp-validation-for="DiaChiGiao" class="text-danger small"></span>
                        </div>
                        <div class="d-grid mt-3">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle"></i> Xác nhận đặt hàng
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tóm tắt giỏ hàng -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="bi bi-bag"></i> Sản phẩm đặt mua</h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var item in Model.GioHang.Items)
                        {
                            <li class="list-group-item px-3 py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@(string.IsNullOrEmpty(item.HinhAnh) ? "/images/no-image.svg" : (item.HinhAnh.StartsWith("http") || item.HinhAnh.StartsWith("/") ? item.HinhAnh : "/" + item.HinhAnh))"
                                             width="45" height="45" class="rounded bg-light" style="object-fit:cover;"
                                             onerror="this.onerror=null; this.src='/images/no-image.svg';" />
                                        <div>
                                            <div class="fw-semibold small">@item.TenSanPham</div>
                                            <small class="text-muted">SL: @item.SoLuong × @item.DonGia.ToString("N0") ₫</small>
                                        </div>
                                    </div>
                                    <strong class="text-success">@item.ThanhTien.ToString("N0") ₫</strong>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between fw-bold fs-6">
                        <span>Tổng cộng:</span>
                        <span class="text-success">@Model.GioHang.TongTien.ToString("N0") ₫</span>
                    </div>
                    <small class="text-muted"><i class="bi bi-truck"></i> Miễn phí vận chuyển</small>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
