@model BTL___QuanLySieuThiNho.Models.HoaDon
@using BTL___QuanLySieuThiNho.Models
@{ ViewData["Title"] = $"Đơn hàng #{Model.MaHd}"; }

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4><i class="bi bi-bag-check"></i> Đơn hàng #@Model.MaHd</h4>
        <a asp-action="LichSuMuaHang" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header"><strong>Sản phẩm đã mua</strong></div>
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr><th>Sản phẩm</th><th>Đơn giá</th><th>Số lượng</th><th>Thành tiền</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ct in Model.ChiTietHoaDons ?? new List<ChiTietHoaDon>())
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <img src="@(string.IsNullOrEmpty(ct.SanPham?.HinhAnh) ? "/images/no-image.svg" : (ct.SanPham!.HinhAnh.StartsWith("http") || ct.SanPham!.HinhAnh.StartsWith("/") ? ct.SanPham!.HinhAnh : "/" + ct.SanPham!.HinhAnh))"
                                                 width="50" height="50" class="rounded bg-light" style="object-fit:cover;"
                                                 onerror="this.onerror=null; this.src='/images/no-image.svg';" />
                                            @ct.SanPham?.TenSp
                                        </div>
                                    </td>
                                    <td>@ct.DonGia.ToString("N0") ₫</td>
                                    <td>@ct.SoLuong</td>
                                    <td class="text-success fw-bold">@((ct.SoLuong * ct.DonGia).ToString("N0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-light fw-bold">
                                <td colspan="3" class="text-end">Tổng cộng:</td>
                                <td class="text-success fs-6">@Model.TongTien.ToString("N0") ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header"><strong>Thông tin giao nhận</strong></div>
                <div class="card-body">
                    <p><strong>Người nhận:</strong> @(Model.TenNguoiNhan ?? Model.KhachHang?.TenKh)</p>
                    <p><strong>SĐT:</strong> @(Model.SdtNhan ?? Model.KhachHang?.SoDienThoai)</p>
                    <p><strong>Địa chỉ:</strong> @(Model.DiaChiGiao ?? Model.KhachHang?.DiaChi)</p>
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                <div class="card-header"><strong>Trạng thái đơn hàng</strong></div>
                <div class="card-body">
                    <p><strong>Ngày đặt:</strong> @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</p>
                    @{
                        var trangThai = (Model.TrangThai ?? 0) switch {
                            0 => ("warning", "Chờ xác nhận"),
                            1 => ("info", "Đã xác nhận"),
                            2 => ("primary", "Đang giao hàng"),
                            3 => ("success", "Đã giao hàng"),
                            4 => ("secondary", "Đã hủy"),
                            _ => ("secondary", "Không xác định")
                        };
                    }
                    <span class="badge bg-@trangThai.Item1 fs-6">@trangThai.Item2</span>
                </div>
            </div>
        </div>
    </div>
</div>
