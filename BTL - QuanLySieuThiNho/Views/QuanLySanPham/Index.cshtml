@model List<BTL___QuanLySieuThiNho.Models.SanPham>
@{ ViewData["Title"] = "Quản lý sản phẩm"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex justify-content-between mb-3 flex-wrap gap-2">
    <form method="get" class="d-flex gap-2 flex-wrap">
        <input type="text" name="timKiem" value="@ViewBag.TimKiem" class="form-control form-control-sm" placeholder="Tìm sản phẩm..." style="width:200px" />
        <select name="loaiSp" class="form-select form-select-sm" style="width:170px">
            <option value="">Tất cả loại SP</option>
            @foreach (var cat in (List<string>)ViewBag.Categories)
            {
                <!option value="@cat" @(ViewBag.LoaiSp == cat ? "selected" : "")>@cat</!option>
            }
        </select>
        <button type="submit" class="btn btn-outline-success btn-sm"><i class="bi bi-search"></i></button>
    </form>
    <a href="/Admin/QuanLySanPham/Them" class="btn btn-success btn-sm">
        <i class="bi bi-plus-circle"></i> Thêm sản phẩm
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr><th>Ảnh</th><th>Mã SP</th><th>Tên sản phẩm</th><th>Loại SP</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr>
                </thead>
                <tbody>
                    @foreach (var sp in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(sp.HinhAnh) ? "/images/no-image.svg" : (sp.HinhAnh.StartsWith("http") || sp.HinhAnh.StartsWith("/") ? sp.HinhAnh : "/" + sp.HinhAnh))"
                                     width="50" height="50" class="rounded bg-light" style="object-fit:cover;"
                                     onerror="this.onerror=null; this.src='/images/no-image.svg';" />
                            </td>
                            <td><code>@sp.MaSp</code></td>
                            <td class="fw-semibold">@sp.TenSp</td>
                            <td><span class="badge bg-info text-dark">@sp.LoaiSp</span></td>
                            <td class="text-success">@sp.GiaBan.ToString("N0") ₫</td>
                            <td>
                                @if ((sp.SoLuongTon ?? 0) <= 20)
                                { <span class="badge bg-danger">@sp.SoLuongTon</span> }
                                else
                                { <span class="badge bg-success">@sp.SoLuongTon</span> }
                            </td>
                            <td>
                                @if (sp.TrangThai == null || sp.TrangThai == 1)
                                { <span class="badge bg-success">Đang bán</span> }
                                else
                                { <span class="badge bg-secondary">Tạm ẩn</span> }
                            </td>
                            <td>
                                <a href="/Admin/QuanLySanPham/Sua/@sp.MaSp" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil"></i></a>
                                <button class="btn btn-outline-warning btn-sm btn-xoa-sp" data-id="@sp.MaSp" title="Ẩn/Hiện sản phẩm">
                                    <i class="bi bi-eye-slash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if ((int)ViewBag.TongSoTrang > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= (int)ViewBag.TongSoTrang; i++)
            {
                <li class="page-item @(i == (int)ViewBag.TrangHienTai ? "active" : "")">
                    <a class="page-link" href="/Admin/QuanLySanPham?trang=@i&timKiem=@ViewBag.TimKiem&loaiSp=@ViewBag.LoaiSp">@i</a>
                </li>
            }
        </ul>
    </nav>
}

@section Scripts {
<script>
    $(document).on('click', '.btn-xoa-sp', function() {
        var id = $(this).data('id');
        $.post('/Admin/QuanLySanPham/Xoa/' + id, function(res) {
            if (res.success) location.reload();
        });
    });
</script>
}
