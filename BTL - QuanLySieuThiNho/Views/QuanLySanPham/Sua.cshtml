@model BTL___QuanLySieuThiNho.Models.SanPham
@{ ViewData["Title"] = "Sửa sản phẩm"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="card border-0 shadow-sm" style="max-width:700px">
    <div class="card-header"><h6 class="mb-0">Sửa sản phẩm</h6></div>
    <div class="card-body p-4">
        <form asp-action="Sua" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="MaSp" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Mã sản phẩm</label>
                    <input class="form-control bg-light" value="@Model.MaSp" disabled />
                </div>
                <div class="col-md-8">
                    <label asp-for="TenSp" class="form-label fw-semibold"></label>
                    <input asp-for="TenSp" class="form-control" />
                    <span asp-validation-for="TenSp" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="GiaBan" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="GiaBan" class="form-control" type="number" min="0" step="1000" />
                        <span class="input-group-text">₫</span>
                    </div>
                    <span asp-validation-for="GiaBan" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SoLuongTon" class="form-label fw-semibold"></label>
                    <input asp-for="SoLuongTon" class="form-control" type="number" min="0" />
                    <span asp-validation-for="SoLuongTon" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="LoaiSp" class="form-label fw-semibold"></label>
                    <input asp-for="LoaiSp" class="form-control" list="loaiSpList" />
                    <datalist id="loaiSpList">
                        @foreach (var c in (List<string>)ViewBag.Categories)
                        {
                            <option value="@c"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Hình ảnh mới</label>
                    <input type="file" name="hinhAnhFile" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        var imgUrl = Model.HinhAnh.StartsWith("http") || Model.HinhAnh.StartsWith("/") ? Model.HinhAnh : "/" + Model.HinhAnh;
                        <div class="mt-2">
                            <img src="@imgUrl" class="rounded border" height="80" style="object-fit:cover;" onerror="this.onerror=null; this.src='/images/no-image.svg';" />
                            <small class="text-muted d-block mt-1">Ảnh hiện tại</small>
                        </div>
                    }
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Trạng thái bán</label>
                    <select asp-for="TrangThai" class="form-select">
                        <option value="1">Đang bán</option>
                        <option value="0">Tạm ẩn</option>
                    </select>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Cập nhật</button>
                <a href="/Admin/QuanLySanPham" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
