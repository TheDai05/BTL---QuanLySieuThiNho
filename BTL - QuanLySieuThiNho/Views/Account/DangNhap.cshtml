@model BTL___QuanLySieuThiNho.ViewModels.DangNhapVM
@{ ViewData["Title"] = "Đăng nhập"; }

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white text-center py-3">
                    <h4 class="mb-0"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Account" asp-action="DangNhap" method="post">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 mb-3">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div><i class="bi bi-exclamation-circle"></i> @error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="TenDangNhap" class="form-label fw-semibold"></label>
                            <input asp-for="TenDangNhap" class="form-control" placeholder="Tên đăng nhập, SĐT hoặc mã KH" required autofocus />
                            <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MatKhau" class="form-label fw-semibold"></label>
                            <input asp-for="MatKhau" class="form-control" type="password" placeholder="Mật khẩu (VD: 123)" required />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>
                        <div class="mb-3 form-check">
                            <input asp-for="GhiNho" class="form-check-input" type="checkbox" />
                            <label asp-for="GhiNho" class="form-check-label">Ghi nhớ đăng nhập</label>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3">
                    Chưa có tài khoản? <a asp-action="DangKy" class="text-success fw-semibold">Đăng ký ngay</a>
                    <span class="mx-2 text-muted">|</span>
                    <a href="/Admin/DangNhap" class="text-secondary small">Trang quản trị Admin</a>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
