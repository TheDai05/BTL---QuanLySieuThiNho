@model BTL___QuanLySieuThiNho.Models.HoaDon
@{ ViewData["Title"] = $"Đơn hàng #{Model.MaHd}"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex justify-content-between mb-3">
    <a href="/Admin/QuanLyDonHang" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="row g-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header"><strong>Chi tiết sản phẩm</strong></div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light"><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
                    <tbody>
                        @foreach (var ct in Model.ChiTietHoaDons ?? new List<BTL___QuanLySieuThiNho.Models.ChiTietHoaDon>())
                        {
                            <tr>
                                <td>@ct.SanPham?.TenSp</td>
                                <td>@ct.DonGia.ToString("N0") ₫</td>
                                <td>@ct.SoLuong</td>
                                <td class="text-success fw-bold">@((ct.SoLuong*ct.DonGia).ToString("N0")) ₫</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="3" class="text-end">Tổng cộng:</td>
                            <td class="text-success">@Model.TongTien.ToString("N0") ₫</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header"><strong>Thông tin đơn hàng</strong></div>
            <div class="card-body">
                <p><strong>Mã hóa đơn:</strong> #@Model.MaHd</p>
                <p><strong>Ngày lập:</strong> @Model.NgayLap.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Khách hàng:</strong> @Model.KhachHang?.TenKh</p>
                <p><strong>Người nhận:</strong> @(Model.TenNguoiNhan ?? Model.KhachHang?.TenKh)</p>
                <p><strong>SĐT:</strong> @(Model.SdtNhan ?? Model.KhachHang?.SoDienThoai)</p>
                <p><strong>Địa chỉ:</strong> @(Model.DiaChiGiao ?? "Tại quầy")</p>
                <hr>
                <label class="form-label fw-semibold">Cập nhật trạng thái</label>
                <select class="form-select sel-trang-thai" data-id="@Model.MaHd">
                    <!option value="0" @(Model.TrangThai == 0 ? "selected" : "")>Chờ xác nhận</!option>
                    <!option value="1" @(Model.TrangThai == 1 ? "selected" : "")>Đã xác nhận</!option>
                    <!option value="2" @(Model.TrangThai == 2 ? "selected" : "")>Đang giao</!option>
                    <!option value="3" @(Model.TrangThai == 3 ? "selected" : "")>Đã giao</!option>
                    <!option value="4" @(Model.TrangThai == 4 ? "selected" : "")>Đã hủy</!option>
                </select>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).on('change', '.sel-trang-thai', function() {
        $.post('/Admin/QuanLyDonHang/CapNhatTrangThai', { id: $(this).data('id'), trangThai: $(this).val() }, function(res) {
            if (res.success) { 
                var msg = document.createElement('div'); 
                msg.className='alert alert-success mt-2'; 
                msg.innerText='Đã cập nhật: ' + res.tenTrangThai; 
                document.querySelector('.sel-trang-thai').after(msg); 
                setTimeout(()=>msg.remove(), 3000); 
            }
        });
    });
</script>
}
